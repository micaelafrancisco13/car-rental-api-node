model Vehicle {
  id                  String             @id @default(uuid())
  // driverId           String?            @unique
  // driver             Driver?            @relation(fields: [driverId], references: [id])
  make                String
  model               String
  year                Int
  licensePlate        String             @unique
  briefDescription    String? // Changed from description to briefDescription
  detailedDescription String?
  features            String[]
  images              String[]
  dailyRate           Decimal
  availabilityStatus  AvailabilityStatus @default(AVAILABLE)
  bookings            Booking[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([availabilityStatus])
}

model Booking {
  id            String         @id @default(uuid())
  bookerId      String
  booker        User           @relation(fields: [bookerId], references: [id])
  // driverId      String?
  // driver        Driver?        @relation(fields: [driverId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  startLocation String
  endLocation   String
  startDate     DateTime       @default(now())
  endDate       DateTime       @updatedAt
  totalPrice    Decimal
  depositPaid   Decimal?        @default(0)
  balance       Decimal?        @default(0)
  status        BookingStatus  @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  deliveryType  DeliveryType   @default(DROPOFF)
  fleetTracking FleetTracking?
  tripHistory   TripHistory[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FleetTracking {
  id              String     @id @default(uuid())
  bookingId       String     @unique
  booking         Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // driverLatitude  Float?
  // driverLongitude Float?
  bookerLatitude  Float?
  bookerLongitude Float?
  speed           Float?
  tripStatus      TripStatus @default(IDLE)
  lastUpdatedAt   DateTime   @updatedAt
}

model TripHistory {
  id          String     @id @default(uuid())
  bookingId   String
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  latitude    Float?
  longitude   Float?
  speed       Float? 
  tripStatus  TripStatus
  drivingDuration Float?
  locations       Location[]
  recordedAt  DateTime   @default(now())
  @@index([bookingId])
  @@index([recordedAt])
}

model Location {
  id          String     @id @default(uuid())
  tripHistoryId String
  tripHistory TripHistory @relation(fields: [tripHistoryId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  recordedAt  DateTime   @default(now())
}
// Enums
enum Role {
  BOOKER
  EMPLOYEE
  ADMIN
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripStatus {
  IDLE
  ON_TRIP
  ON_THE_WAY
  PICKED_UP
  DROPPED_OFF
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DeliveryType {
  PICKUP
  DROPOFF
}
